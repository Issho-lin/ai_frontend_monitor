{
  "name": "ai-frontend-monitor",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "install:all": "bash scripts/install-all.sh",
    "dev": "pnpm build:packages && pnpm dev:infra && concurrently -k -n console,api,gateway,worker -c cyan,green,yellow,magenta \"pnpm dev:console\" \"pnpm dev:api\" \"pnpm dev:gateway\" \"pnpm dev:worker\"",
    "dev:infra": "docker compose up -d --wait postgres clickhouse redis redpanda minio && docker compose up minio-setup",
    "dev:console": "pnpm --filter @ai-frontend-monitor/console dev",
    "dev:demo": "pnpm --filter @ai-frontend-monitor/demo dev",
    "dev:api": "pnpm --filter @ai-frontend-monitor/api start:dev",
    "dev:gateway": "pnpm --filter @ai-frontend-monitor/gateway start:dev",
    "dev:worker": "pnpm --filter @ai-frontend-monitor/worker start:dev",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:console": "pnpm --filter @ai-frontend-monitor/console build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
