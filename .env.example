# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=afm
POSTGRES_PASSWORD=CHANGE_ME_DEV_SECRET
POSTGRES_DB=afm

# ─── ClickHouse ─────────────────────────────────────────────────────────────
CLICKHOUSE_DB=afm
CLICKHOUSE_USER=afm
CLICKHOUSE_PASSWORD=CHANGE_ME_DEV_SECRET

# ─── Redis ──────────────────────────────────────────────────────────────────
# No auth in dev; set REDIS_PASSWORD in production

# ─── Redpanda ───────────────────────────────────────────────────────────────
# No auth in dev; Redpanda uses SCRAM in production

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_DEV_SECRET

# ─── Gateway ingest auth (projectId → token JSON map) ───────────────────────
# Empty `projects` table is seeded from this map on API startup (hash + mask only).
# Gateway reads `project_tokens` in Postgres. This map is the fallback when the
# database is down or the project row does not exist yet.
# Use AFM_PROJECT_TOKENS (preferred) or PROJECT_TOKENS.
# If both are unset, the default is demo→afm-demo-token.
AFM_PROJECT_TOKENS={"demo":"afm-demo-token"}
# AFM_TOKEN_CACHE_TTL_MS=5000

# Optional ingest rate limit (per projectId|client IP, fixed window)
INGEST_RATE_LIMIT=120
INGEST_RATE_WINDOW_MS=60000

# ─── App ports (docker-compose.prod.yml) ────────────────────────────────────
API_PORT=3000
GATEWAY_PORT=3001
CONSOLE_PORT=8080
DEMO_PORT=8081
KAFKA_GROUP_ID=afm-worker-group

# ─── Alerts notify (api) ────────────────────────────────────────────────────
# Optional. When set, firing alerts POST JSON to this URL (Slack/Discord/custom).
# Same fingerprint is deduped for ALERT_NOTIFY_DEDUPE_MINUTES (default 15).
# ALERT_WEBHOOK_URL=
# ALERT_NOTIFY_DEDUPE_MINUTES=15
